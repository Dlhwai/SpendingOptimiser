# Copy to .env (gitignored) next to where you start the app, or point
# SPENDING_OPTIMISER_ENV / --env-file at another file. Plaintext, not encryption.
# Never commit .env or paste its values anywhere.

# Google Desktop app OAuth client (docs/gmail.md). Written by --configure-google too.
SPENDING_GOOGLE_CLIENT_ID=
SPENDING_GOOGLE_CLIENT_SECRET=

# Absolute path of the official native Codex 0.164.0 executable (docs/subscription-ai.md).
# ChatGPT sign-in tokens stay in the official client's own keyring, never in this file.
SPENDING_CODEX_CLIENT=

# The app writes SPENDING_GMAIL_AUTHORIZATION_<ledger digest> here after you connect Gmail
# and removes it on Disconnect.
